# Copy to `.env` (backend) or set in your shell, then adjust values.

# PostgreSQL connection (used by the backend and Alembic)
DATABASE_URL=postgresql+asyncpg://postgres:DEX@localhost:5432/busgo_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=DEX
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=busgo_db

# JWT signing secret — CHANGE THIS in any non-local environment
JWT_SECRET_KEY=busgo-dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Frontend (create frontend/.env.local from these when needed):
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:8000   # override if backend is remote
#   NEXT_PUBLIC_ALLOWED_ORIGINS=192.168.1.50    # extra dev hosts (comma-separated)

# ---------------------------------------------------------------------------
# M-Pesa Daraja (real STK push). Leave blank to use the simulated M-Pesa flow.
# ---------------------------------------------------------------------------
# sandbox | production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
# Public HTTPS URL that reaches POST /api/pay/daraja/callback
MPESA_CALLBACK_URL=https://your-domain.example.com/api/pay/daraja/callback
