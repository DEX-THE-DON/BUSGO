# =====================================================================
# BUSGO Production Environment Configuration Template
# =====================================================================
# Copy this file to .env.production on your production server:
#   cp .env.production.example .env.production
# =====================================================================

# 1. Domain & Networking
APP_DOMAIN=busgo.co.ke
ACME_EMAIL=admin@busgo.co.ke
FRONTEND_URL=https://busgo.co.ke
NEXT_PUBLIC_API_URL=https://busgo.co.ke

# 2. PostgreSQL Production Database
POSTGRES_USER=busgo_admin
POSTGRES_PASSWORD=replace_with_a_strong_random_password_64_chars
POSTGRES_DB=busgo_db
POSTGRES_HOST_PORT=5432

# 3. Authentication & Security
SECRET_KEY=generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# 4. Safaricom M-Pesa Daraja Integration (Live / Sandbox)
MPESA_ENV=production
MPESA_CONSUMER_KEY=your_live_safaricom_consumer_key
MPESA_CONSUMER_SECRET=your_live_safaricom_consumer_secret
MPESA_PASSKEY=your_live_stk_passkey
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://busgo.co.ke/api/pay/daraja/callback

# M-Pesa B2C Automated Payouts (Vehicle Owner Splits & SACCO Dividends)
MPESA_B2C_INITIATOR=busgo_initiator
MPESA_B2C_SECURITY_CREDENTIAL=your_encrypted_b2c_credential
MPESA_B2C_SHORTCODE=600000
MPESA_B2C_RESULT_URL=https://busgo.co.ke/api/pay/daraja/b2c-result
MPESA_B2C_TIMEOUT_URL=https://busgo.co.ke/api/pay/daraja/b2c-timeout

# 5. Africa's Talking USSD (*384#) & SMS Dispatch
AT_USERNAME=busgo_kenya
AT_API_KEY=your_africas_talking_api_key
AT_SENDER_ID=BUSGO
USSD_SERVICE_CODE=*384#

# 6. Hardware GPS Tracker Ports
# Teltonika FMB920 / FMC130 Codec 8 / Codec 8 Extended port
TELTONIKA_PORT=5027
# Concox GT06 protocol port
CONCOX_PORT=5023
